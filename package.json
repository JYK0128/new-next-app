{
  "name": "my-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "devenv": "dotenvx run -f .env.development --",
    "stgenv": "dotenvx run -f .env.staging --",
    "prdenv": "dotenvx run -f .env.production --",
    "prisma:gen": "npm run devenv -- tsx codegen-prisma.ts",
    "dev": "npm run devenv -- next dev",
    "build": "npm run prdenv -- next build",
    "start": "npm run prdenv -- next start",
    "lint": "next lint",
    "prisma:init": "prisma init --datasource-provider postgresql",
    "prisma:seed": "npm run devenv -- tsx prisma/seed.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@as-integrations/next": "^4.0.0",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.84.0",
    "@trpc/client": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "@trpc/tanstack-react-query": "^11.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "event-source-polyfill": "^1.0.31",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.535.0",
    "next": "15.4.5",
    "next-auth": "5.0.0-beta.29",
    "next-intl": "^4.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "superjson": "^2.2.2",
    "swagger-ui-react": "^5.27.1",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "trpc-to-openapi": "^2.3.2",
    "zod": "~3.24"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "4.1.0",
    "@dotenvx/dotenvx": "^1.48.4",
    "@eslint/compat": "^1.3.1",
    "@eslint/eslintrc": "^3",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/schema-ast": "^4.1.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@parcel/watcher": "^2.5.1",
    "@storybook/addon-a11y": "9.1.1",
    "@storybook/addon-docs": "9.1.1",
    "@storybook/addon-vitest": "9.1.1",
    "@storybook/nextjs-vite": "^9.1.1",
    "@stylistic/eslint-plugin": "^5.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.5",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sonarjs": "^3.0.4",
    "eslint-plugin-storybook": "9.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "playwright": "^1.54.2",
    "prettier": "^3.6.2",
    "prisma": "^5",
    "storybook": "9.1.1",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "react": "^19.1.0",
      "react-dom": "^19.1.0"
    }
  },
  "scarfSettings": {
    "enabled": false
  }
}
