generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                                      String       @id @map("id") @db.Uuid
  sub                                     String       @map("sub") @db.Uuid
  createdAt                               DateTime     @map("created_at") @db.Timestamp(6)
  createdBy                               String       @map("created_by") @db.Uuid
  updatedAt                               DateTime     @map("updated_at") @db.Timestamp(6)
  updatedBy                               String       @map("updated_by") @db.Uuid
  deletedAt                               DateTime?    @map("deleted_at") @db.Timestamp(6)
  deletedBy                               String?      @map("deleted_by") @db.Uuid
  metadata                                Json?        @map("metadata")
  blogPostBlogPostCreatedByToappUsers     BlogPost[]   @relation("blog_post_created_byToapp_user")
  blogPostBlogPostUpdatedByToappUsers     BlogPost[]   @relation("blog_post_updated_byToapp_user")
  fileUploadFileUploadCreatedByToappUsers FileUpload[] @relation("file_upload_created_byToapp_user")
  fileUploadFileUploadUpdatedByToappUsers FileUpload[] @relation("file_upload_updated_byToapp_user")

  @@index([metadata], map: "idx_app_user_metadata_gin", type: Gin)
  @@map("app_user")
}

model BlogComment {
  id        String    @id @map("id") @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  content   String    @map("content")
  createdAt DateTime  @map("created_at") @db.Timestamp(6)
  createdBy String    @map("created_by") @db.Uuid
  updatedAt DateTime  @map("updated_at") @db.Timestamp(6)
  updatedBy String    @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)
  deletedBy String?   @map("deleted_by") @db.Uuid
  metadata  Json?     @map("metadata")
  blogPost  BlogPost  @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([metadata], map: "idx_blog_comment_metadata_gin", type: Gin)
  @@map("blog_comment")
}

model BlogPost {
  id                                String        @id @map("id") @db.Uuid
  title                             String        @map("title") @db.VarChar(255)
  content                           String        @map("content")
  thumbnail                         String?       @map("thumbnail")
  createdAt                         DateTime      @map("created_at") @db.Timestamp(6)
  createdBy                         String        @map("created_by") @db.Uuid
  updatedAt                         DateTime      @map("updated_at") @db.Timestamp(6)
  updatedBy                         String        @map("updated_by") @db.Uuid
  deletedAt                         DateTime?     @map("deleted_at") @db.Timestamp(6)
  deletedBy                         String?       @map("deleted_by") @db.Uuid
  metadata                          Json?         @map("metadata")
  blogComments                      BlogComment[]
  appUserBlogPostCreatedByToappUser AppUser       @relation("blog_post_created_byToapp_user", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appUserBlogPostUpdatedByToappUser AppUser       @relation("blog_post_updated_byToapp_user", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([metadata], map: "idx_blog_post_metadata_gin", type: Gin)
  @@map("blog_post")
}

model FileUpload {
  id                                  String    @id @map("id") @db.Uuid
  url                                 String    @map("url")
  name                                String    @map("name") @db.VarChar(255)
  type                                String    @map("type") @db.VarChar(50)
  size                                Int       @map("size")
  createdAt                           DateTime  @map("created_at") @db.Timestamp(6)
  createdBy                           String    @map("created_by") @db.Uuid
  updatedAt                           DateTime  @map("updated_at") @db.Timestamp(6)
  updatedBy                           String    @map("updated_by") @db.Uuid
  deletedAt                           DateTime? @map("deleted_at") @db.Timestamp(6)
  deletedBy                           String?   @map("deleted_by") @db.Uuid
  metadata                            Json?     @map("metadata")
  appUserFileUploadCreatedByToappUser AppUser   @relation("file_upload_created_byToapp_user", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appUserFileUploadUpdatedByToappUser AppUser   @relation("file_upload_updated_byToapp_user", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([metadata], map: "idx_file_upload_metadata_gin", type: Gin)
  @@map("file_upload")
}
