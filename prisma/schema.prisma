generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["typedSql"]
}

generator pothos {
  provider = "prisma-pothos-types"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comments {
  id        BigInt    @id @map("id")
  postId    BigInt    @map("post_id")
  authorId  String?   @map("author_id") @db.Uuid
  nickname  String    @map("nickname") @db.VarChar(255)
  content   String    @map("content")
  createdAt DateTime  @map("created_at") @db.Timestamp(6)
  updatedAt DateTime  @map("updated_at") @db.Timestamp(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamp(6)
  metadata  Json?     @map("metadata")
  users     Users?    @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  posts     Posts     @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("comments")
}

model Posts {
  id         BigInt     @id @map("id")
  title      String     @map("title") @db.VarChar(255)
  slug       String     @unique @map("slug") @db.VarChar(255)
  content    String     @map("content")
  thumbnail  String?    @map("thumbnail")
  views      BigInt     @default(0) @map("views")
  likes      BigInt     @default(0) @map("likes")
  createdAt  DateTime   @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime   @map("updated_at") @db.Timestamp(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamp(6)
  metadata   Json?      @map("metadata")
  authorId   String     @map("author_id") @db.Uuid
  commentses Comments[]
  users      Users      @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("posts")
}

model Users {
  id           String     @id @map("id") @db.Uuid
  email        String     @map("email") @db.VarChar(255)
  nickname     String     @map("nickname") @db.VarChar(255)
  blockedUntil DateTime?  @map("blocked_until") @db.Timestamp(6)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamp(6)
  lastLogoutAt DateTime?  @map("last_logout_at") @db.Timestamp(6)
  createdAt    DateTime   @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime   @map("updated_at") @db.Timestamp(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamp(6)
  metadata     Json?      @map("metadata")
  commentses   Comments[]
  postses      Posts[]

  @@map("users")
}
